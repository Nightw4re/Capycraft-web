{
  "name": "capycraft-web",
  "private": true,
  "scripts": {
    "graphify": "node scripts/graphify.mjs",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "start:api": "node --env-file-if-exists=.env.local server/index.mts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "import:items": "node scripts/import-items.mjs",
    "export:nugwa": "node --input-type=module -e \"import { runnerImport } from 'vite'; await runnerImport('./scripts/export-nugwa.mts', { configFile: false });\" --",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "~8.3.8"
  },
  "dependencies": {
    "@clerk/backend": "^3.31.4",
    "@clerk/localizations": "^4.26.3",
    "@clerk/react": "^6.19.4",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "yauzl": "^3.4.0"
  }
}
