import { readFile, writeFile } from 'node:fs/promises';
import { basename } from 'node:path';
import { setTimeout } from 'node:timers/promises';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import { portraitCast } from '../src/portrait/portraitCast';
import type { PortraitPlayer } from '../src/portrait/portraitScene';
import type { PortraitSkin } from '../src/portrait/skinGeometry';

const config = new URL('../portrait-players.json', import.meta.url);
const assets = new URL('../assets/', import.meta.url);

async function fetchMinecraft(url: string): Promise<Response> {
  const request = () => fetch(url, { signal: AbortSignal.timeout(10_000) });
  const response = await request();
  if (response.status !== 429) return response;

  const retryAfter = response.headers.get('retry-after');
  const delay = retryAfter && /^\d+$/.test(retryAfter) ? Number(retryAfter) * 1000 : 60_000;
  if (delay > 60_000) return response;

  await response.body?.cancel();
  await setTimeout(Math.max(1000, delay));
  return request();
}

export async function readSkin({ name, skin, model }: PortraitPlayer): Promise<PortraitSkin> {
  const { data, info } = await sharp(fileURLToPath(skin)).toColourspace('srgb').ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  const legacy = info.height === 32;
  if (info.width !== 64 || (!legacy && info.height !== 64)) throw new Error(`Invalid Java skin for ${name}`);
  const pixels = new Uint8ClampedArray(64 * 64 * 4);
  pixels.set(data);
  return { pixels, model: legacy ? 'legacy' : model };
}

async function downloadSkin(name: string): Promise<PortraitPlayer> {
  const profile = await fetchMinecraft(`https://api.mojang.com/users/profiles/minecraft/${name}`);
  if (!profile.ok || profile.status === 204) throw new Error(`Minecraft profile lookup failed for ${name} (${profile.status})`);
  const { id } = await profile.json() as { id?: string };
  if (typeof id !== 'string' || !/^[a-f0-9]{32}$/i.test(id)) throw new Error(`Invalid Minecraft profile for ${name}`);

  const session = await fetchMinecraft(`https://sessionserver.mojang.com/session/minecraft/profile/${id}`);
  if (!session.ok || session.status === 204) throw new Error(`Minecraft session lookup failed for ${name} (${session.status})`);
  const { properties } = await session.json() as { properties?: { name: string; value: string }[] };
  const texture = properties?.find(property => property.name === 'textures')?.value;
  if (!texture) throw new Error(`Minecraft did not return skin information for ${name}`);

  const { textures } = JSON.parse(Buffer.from(texture, 'base64').toString('utf8')) as {
    textures?: { SKIN?: { url: string; metadata?: { model?: string } } };
  };
  const skin = textures?.SKIN;
  const hash = skin?.url.match(/^https?:\/\/textures\.minecraft\.net\/texture\/([a-f0-9]{32,64})$/i)?.[1];
  if (!hash) throw new Error(`No custom Java skin found for ${name}`);
  const image = await fetchMinecraft(`https://textures.minecraft.net/texture/${hash}`);
  if (!image.ok) throw new Error(`Could not download the Minecraft skin for ${name} (${image.status})`);
  const bytes = Buffer.from(await image.arrayBuffer());
  const { format, width, height } = await sharp(bytes).metadata();
  if (format !== 'png' || width !== 64 || (height !== 32 && height !== 64)) throw new Error(`Invalid Java skin for ${name}`);

  const destination = new URL(`${name.toLowerCase()}-${hash.slice(0, 12)}.png`, assets);
  await writeFile(destination, bytes);
  return { name, model: skin?.metadata?.model === 'slim' ? 'slim' : 'classic', skin: destination };
}

export async function resolvePortraitCast(refresh: boolean): Promise<PortraitPlayer[]> {
  const names: unknown = JSON.parse(await readFile(config, 'utf8'));
  if (!Array.isArray(names) || !names.length || names.some(name => typeof name !== 'string' || !/^[\w]{1,16}$/.test(name))) {
    throw new Error('portrait-players.json must contain at least one Minecraft username');
  }
  if (new Set(names.map(name => name.toLowerCase())).size !== names.length) {
    throw new Error('portrait-players.json contains a repeated Minecraft username');
  }

  const players: PortraitPlayer[] = [];
  for (const name of names as string[]) {
    const cached = portraitCast.find(player => player.name.toLowerCase() === name.toLowerCase());
    players.push(cached && !refresh ? { ...cached, name } : await downloadSkin(name));
  }
  return players;
}

export async function writePortraitCast(players: PortraitPlayer[]) {
  const entries = players.map(({ name, skin, model }) => {
    const file = basename(fileURLToPath(skin));
    return `  { name: ${JSON.stringify(name)}, model: ${JSON.stringify(model)}, skin: new URL(${JSON.stringify(`../../assets/${file}`)}, import.meta.url) },`;
  });
  const module = [
    '// Generated by npm run export:nugwa. Edit portrait-players.json to change the cast.',
    "import type { PortraitPlayer } from './portraitScene';",
    '', 'export const portraitCast: PortraitPlayer[] = [', ...entries, '];', '',
  ].join('\n');
  const destination = new URL('../src/portrait/portraitCast.ts', import.meta.url);
  if (module !== await readFile(destination, 'utf8')) await writeFile(destination, module);
}
